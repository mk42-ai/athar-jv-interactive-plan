#!/usr/bin/env python3
"""Exec-only shim: ui-validator remains the only browser/CDP driver.

App windows avoid Chromium's 500px tabbed-window minimum. The baseline measured
56px of window chrome. Override the compensation if Chromium changes; exact
inner dimensions are asserted by the harness, never assumed from launch flags.
"""
import os
import sys

binary = os.environ.get('ATHAR_CHROMIUM_REAL_BIN', '/usr/bin/chromium')
chrome_height = int(os.environ.get('ATHAR_CHROME_HEIGHT', '56'))
args = []
for arg in sys.argv[1:]:
    if arg.startswith('--window-size='):
        width, height = map(int, arg.split('=', 1)[1].split(','))
        arg = f'--window-size={width},{height + chrome_height}'
    args.append(arg)
os.execv(binary, [binary, '--headless=new', '--app=http://127.0.0.1',
                  '--autoplay-policy=no-user-gesture-required', *args])
