{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/guide-audio/:file", "destination": "/api/guide-audio/:file" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "{data/**,guide-script.json,presentation-config.json,public/deck/**,public/guide-audio/**}"
    }
  }
}
