# Optional server-only settings. The document UI does not require an .env file.
# Inject existing credentials through the host secret store; never prefix them VITE_.
ON_DEMAND_API_KEY=
# ONDEMAND_API_KEY is an accepted alias. Missing/invalid credentials fail honestly.
OD_ENDPOINT_ID=predefined-openai-gpt4o
# Host-only allowlisted corpus: index.json, corpus.sqlite, originals/, raw/, views/.
ATHAR_CORPUS_DIR=
ATHAR_BUILD_SHA=
ATHAR_FRAME_ANCESTORS=*
# Optional existing owner-readable server configuration file:
# ATHAR_CONFIG_FILE=/secure/athar.env
