# SERVER-ONLY configuration template. No real value belongs in this repository.
# Prefer your host's encrypted environment/secret store. Alternatively point
# ATHAR_CONFIG_FILE at an owner-readable (0600) file OUTSIDE the project/static root.
# Never prefix a credential with VITE_; never copy secrets into source archives.
ON_DEMAND_API_KEY=your-on-demand-api-key-here
# ONDEMAND_API_KEY is also accepted. Reuse the existing installed account credential.
OD_ENDPOINT_ID=predefined-openai-gpt4o
# New private document/chat access: provision a separate reviewer access code, NOT the AI API key.
ATHAR_REVIEW_PASSPHRASE=choose-a-reviewer-access-code
# At least 32 characters; cryptographically random, separate from reviewer passphrase.
ATHAR_SESSION_SECRET=generate-32-plus-random-characters
# Absolute protected directory containing index.json, originals/, and raw/ (never public/).
ATHAR_CORPUS_DIR=/absolute/path/to/athar-corpus
# Immutable presentation data, original PDF and verified narration clips. Outside repo/static root; mode 0700/0600.
ATHAR_PRESENTATION_DIR=/absolute/path/to/athar-presentation
# Enable for confidential review deployments: protects the app bundle, deck, narration and QA assets too.
ATHAR_PRIVATE_PRESENTATION=1
ATHAR_BUILD_SHA=
# Optional absolute path to a host-only secret file:
# ATHAR_CONFIG_FILE=/secure/athar.env
# The public presentation guide uses ONLY existing SHA256-verified prerecorded River clips.
# ElevenLabs credentials are needed only for the explicit operator rebake script, never playback.
ELEVENLABS_API_KEY=
ELEVEN_VOICE_ID=SAz9YHcvj6GT2YYXdXww
ELEVEN_VOICE_NAME=River
ELEVEN_MODEL=eleven_v3
ELEVEN_STABILITY=0.5
ELEVEN_SIMILARITY=0.8
ELEVEN_STYLE=0
ELEVEN_SPEED=0.92
# Existing authorized Advanced Voice Mode integration:
AVM_WORKFLOW_ID=6a97acf9b44c27163d2b211c
OD_TTS_VOICE=nova
OD_TTS_MODEL=tts-1
# Set only to your trusted application origin, never client input:
# PUBLIC_BASE_URL=https://your-host.example
# ---- Embedding (preview panels / iframes) -------------------------------------------------------
# The workspace is opened inside embedded preview panels (cross-origin iframes). Responses therefore
# send `Content-Security-Policy: frame-ancestors <list>` instead of the old `X-Frame-Options: SAMEORIGIN`
# (which made browsers show "refused to connect" in an iframe). Default `*` = any embedder; restrict with
# a space-separated CSP source list, e.g. 'self' https://app.example
ATHAR_FRAME_ANCESTORS=*
# Reviewer session cookie SameSite policy: none (default; emitted as `SameSite=None; Secure` on HTTPS so
# sign-in works inside iframes AND top-level tabs — plain-HTTP dev hosts fall back to Lax), lax, or strict.
# CSRF protection does not depend on this: mutating routes always enforce the same-origin check.
ATHAR_COOKIE_SAMESITE=none
