# Copy to .env (git-ignored) or set in your host's environment. The server loads .env itself at start-up
# (server/env.js) and logs a masked fingerprint + a live On Demand probe result; GET /api/health?probe=1 re-checks.
# Server-side only — never prefix any of these with VITE_ (that would expose them to the browser bundle).
# On Vercel: Project → Settings → Environment Variables (same names) — the .env file is not deployed.
ON_DEMAND_API_KEY=                 # On Demand platform key — chat, voice, and the TTS FALLBACK for Guide Mode
ELEVENLABS_API_KEY=                # Guide Mode narration PRIMARY provider (validated: sk_… keys authenticate against api.elevenlabs.io)
ELEVEN_VOICE_ID=SAz9YHcvj6GT2YYXdXww   # River — relaxed, neutral US narrator (premade). Library voices need a paid plan (HTTP 402 on free tier)
ELEVEN_VOICE_NAME=River
ELEVEN_MODEL=eleven_v3             # falls back to ELEVEN_FALLBACK_MODEL, then to On Demand
ELEVEN_FALLBACK_MODEL=eleven_multilingual_v2
ELEVEN_STABILITY=0.5               # eleven_v3 'Natural'
ELEVEN_SIMILARITY=0.8
ELEVEN_STYLE=0.0
ELEVEN_SPEED=0.92
AVM_WORKFLOW_ID=6a97acf9b44c27163d2b211c
OD_ENDPOINT_ID=predefined-openai-gpt4o
OD_TTS_VOICE=nova
OD_TTS_MODEL=tts-1
OD_GUIDE_VOICE=nova              # Guide Mode narrator — natural soft-spoken US female
OD_GUIDE_MODEL=gpt-4o-mini-tts   # honours delivery instructions; falls back to OD_GUIDE_FALLBACK_MODEL
OD_GUIDE_FALLBACK_MODEL=tts-1-hd
OD_GUIDE_SPEED=0.92
# Optional: public base URL when a proxy in front does not forward Host / X-Forwarded-* (voice STT fetches audio from it)
# PUBLIC_BASE_URL=https://your-domain.example
