# SERVER-ONLY configuration template. No real value belongs in this repository.
# Prefer your host's encrypted environment/secret store. Alternatively point
# ATHAR_CONFIG_FILE at an owner-readable (0600) file OUTSIDE the project/static root.
# Never prefix a credential with VITE_; never copy secrets into source archives.
ON_DEMAND_API_KEY=
# ONDEMAND_API_KEY is also accepted. Reuse the existing installed account credential.
OD_ENDPOINT_ID=predefined-openai-gpt4o
# Absolute protected directory containing index.json, originals/, and raw/ (never public/).
ATHAR_CORPUS_DIR=
# Optional override: private presentation store outside repo/static root; mode 0700/0600.
# When unset, bundled repo assets (guide-script.json, presentation-config.json, data/*) are served publicly.
ATHAR_PRESENTATION_DIR=
# Access: the workspace is PUBLIC — presentation and document-connected AI open to anyone with the URL.
# There is no reviewer code, login, session cookie or bearer token. Keep the deployment URL as private as the content.

ATHAR_BUILD_SHA=
# Chat diagnostics: every On Demand call already logs "[ondemand] <route> → HTTP <status> (<ms>) answerChars=<n>";
# set to 1 to also log the RAW upstream response bodies (truncated) when tracing empty or wrong answers.
ATHAR_DEBUG_UPSTREAM=0
# Optional absolute path to a host-only secret file:
# ATHAR_CONFIG_FILE=/secure/athar.env
# The public presentation guide uses ONLY existing SHA256-verified prerecorded River clips.
# ElevenLabs credentials are needed only for the explicit operator rebake script, never playback.
ELEVENLABS_API_KEY=
ELEVEN_VOICE_ID=SAz9YHcvj6GT2YYXdXww
ELEVEN_VOICE_NAME=River
ELEVEN_MODEL=eleven_v3
ELEVEN_STABILITY=0.5
ELEVEN_SIMILARITY=0.8
ELEVEN_STYLE=0
ELEVEN_SPEED=0.92
# Existing authorized Advanced Voice Mode integration:
AVM_WORKFLOW_ID=6a97acf9b44c27163d2b211c
OD_TTS_VOICE=nova
OD_TTS_MODEL=tts-1
# Set only to your trusted application origin, never client input:
# PUBLIC_BASE_URL=https://your-host.example

# ---- Document-connected AI: the THREE corpus documents (5 Sept 2026 set) ----------------------------------
# Originals live OUTSIDE the repository. `npm run provision` keeps files already present beneath
# ATHAR_SOURCE_INPUT_DIR, downloads any missing original from its signed URL below (HTTPS only, time-limited SAS
# links — never commit them; this repository is public), then runs the offline ingestion into ATHAR_CORPUS_DIR.
ATHAR_SOURCE_INPUT_DIR=
# (1) Athar JV — Financial Model Executive Summary (3).pdf  (model basis v13, 3 September 2026)
ATHAR_SOURCE_URL_FINANCIAL_SUMMARY=
# (2) athar-jv-model-v13 (1).xlsx — the financial model v13 workbook
ATHAR_SOURCE_URL_FINANCIAL_MODEL=
# (3) ODA_X_AIREV_Athar_6_Month_Implementation_Plan_Oct2026_Mar2027_v1 (1) (1).xlsx
ATHAR_SOURCE_URL_IMPLEMENTATION_PLAN=
